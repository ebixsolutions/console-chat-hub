  "helper": {
    "definition": "CREATE OR REPLACE FUNCTION public.has_company_role(p_company_id uuid, p_user_id uuid, p_role app_role)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select (\n    (session_user = 'postgres' and auth.uid() is null and auth.role() is null)\n    or auth.role() = 'service_role'\n    or p_user_id = auth.uid()\n  ) and exists (\n    select 1\n    from public.company_membership cm\n    where cm.company_id = p_company_id\n      and cm.user_id = p_user_id\n      and cm.role = p_role\n      and cm.is_active\n  );\n$function$\n",
    "role_values": [
